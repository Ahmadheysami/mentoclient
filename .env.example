# Client (Nuxt) — local development values.
# Copy to `.env`. Docker builds ignore `.env`; docker-compose injects the
# production values explicitly in its `client.environment` block.

NUXT_API_KEY=open

# Build-time API base (nuxt.config.ts → runtimeConfig.apiUrl default).
NUXT_API_BASE=http://localhost:3001/.api

# Runtime API base (overrides runtimeConfig.apiUrl at runtime).
# In Docker this is http://server:3001/.api
NUXT_API_URL=http://localhost:3001/.api

# Runtime public base (runtimeConfig.public.base → browser Socket.IO origin).
# In production this is https://api.mentoya.ir
NUXT_PUBLIC_BASE=http://localhost:3001
